# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables (then redeploy).
# Anything without the NEXT_PUBLIC_ prefix is server-only and never reaches the browser.

# ── Supabase (create the project in the EU / Frankfurt region) ────────────────
# Public values — safe in the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC and never reference from client code.
SUPABASE_SERVICE_ROLE_KEY=

# ── Quote requests: email notification ───────────────────────────────────────
# Easiest: a Gmail App Password for visionsoftec5@gmail.com
# (Google Account → Security → 2-Step Verification → App passwords).
# With only this set, requests are emailed from and to visionsoftec5@gmail.com.
GMAIL_APP_PASSWORD=
# Optional overrides:
# GMAIL_USER=visionsoftec5@gmail.com
# INQUIRY_NOTIFY_TO=visionsoftec5@gmail.com
# Any other SMTP server instead of Gmail (e.g. the company mail server):
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# Or Resend (https://resend.com) instead of SMTP:
# RESEND_API_KEY=
# INQUIRY_EMAIL_FROM="Softec Vision <website@your-verified-domain>"

# Signs anti-spam form tokens. Optional: falls back to a secret above.
# Generate with: openssl rand -hex 32
# INQUIRY_TOKEN_SECRET=

# The form submits online once Supabase and/or email is configured. Until then
# it opens WhatsApp with the visitor's details, so no request is lost.

# ── Site URL (canonical / hreflang / Open Graph) ─────────────────────────────
# Defaults to Vercel's production URL. Set once the final domain is connected.
# NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Analytics ────────────────────────────────────────────────────────────────
# GA4 Measurement ID, e.g. G-XXXXXXXXXX. While empty, no analytics loads at all;
# when set, it still loads only after the visitor consents.
NEXT_PUBLIC_GA4_ID=
