# ── Supabase (create a project in the EU / Frankfurt region) ──────────────────
# Public values — safe to expose to the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC and never reference from client code.
SUPABASE_SERVICE_ROLE_KEY=

# ── Analytics (Phase 3) ───────────────────────────────────────────────────────
# GA4 Measurement ID, e.g. G-XXXXXXXXXX. Leave empty until launch — while empty,
# no analytics loads and no analytics request is made (consent-gated regardless).
NEXT_PUBLIC_GA4_ID=

# ── Anti-spam (Phase 2/3) ─────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
